<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Template. launchd expands neither ~ nor $HOME, so every path in a plist has
    to be literal — which would pin the checkout to one machine. install.sh
    renders the __PLACEHOLDERS__ from its own location and installs the result
    as ~/Library/LaunchAgents/com.qoob23.codelink.plist. Edit this file, never
    the rendered one, then re-run install.sh.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.qoob23.codelink</string>

    <key>ProgramArguments</key>
    <array>
        <string>__BIN__</string>
        <string>serve</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- A launchd agent inherits PATH=/usr/bin:/bin:/usr/sbin:/sbin, which has
             neither nvim nor ghostty. -->
        <key>PATH</key>
        <string>__PATH__</string>
        <key>CODELINK_PORT</key>
        <string>47391</string>
        <key>CODELINK_NVIM</key>
        <string>__NVIM__</string>
        <!-- Where `serve` writes token.gen.js: the checkout's extension/. -->
        <key>CODELINK_EXTENSION_DIR</key>
        <string>__EXTENSION_DIR__</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!-- Dict rather than <true/>: a clean exit stays down (so `codelink` can be
         stopped deliberately), a crash is restarted. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Keeps the daemon out of the low-priority background band, so a hover
         that hits a cold FUSE stat is not additionally throttled. -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>__STATE_DIR__/daemon.out.log</string>
    <key>StandardErrorPath</key>
    <string>__STATE_DIR__/daemon.err.log</string>
</dict>
</plist>
